@model VibeWave.Models.ViewModels.ConcertVM
<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class=" col text-center">
                <h2 class="text-white py-2">@(Model.Concert.Id != 0 ? "Update" : "Create") Concert</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">

    <form method="post" class="row" enctype="multipart/form-data">
        <input asp-for="Concert.Id" hidden />
        <input asp-for="Concert.ConcertImageUrl" hidden />
            <div class="row">
                <div class=" col-10">
                    <div class="border p-3">
                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.ConcertName" class="ms-2"> </label>
                            <input asp-for="Concert.ConcertName" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.ConcertName" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.ActorName" class="ms-2"> </label>
                            <input asp-for="Concert.ActorName" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.ActorName" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.ConcertLocation" class="ms-2"> </label>
                            <input asp-for="Concert.ConcertLocation" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.ConcertLocation" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.DisplayDate" class="ms-2"> </label>
                            <input asp-for="Concert.DisplayDate" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.DisplayDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.DisplayTime" class="ms-2"> </label>
                            <input asp-for="Concert.DisplayTime" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.DisplayTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.TicketPrice" class="ms-2"> </label>
                            <input asp-for="Concert.TicketPrice" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.TicketPrice" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.CategoryId" class="ms-2"> </label>
                            <select asp-for="Concert.CategoryId" asp-items="@Model.CategoryList" class="form-control border-0 shadow">
                                <option disabled selected>--Select Category</option>
                            </select>
                            <span asp-validation-for="Concert.CategoryId" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row p-1">
                            <label asp-for="Concert.ConcertImageUrl" class="ms-2"> </label>
                            <input type="file" name="file" class="form-control border-0 shadow" />
                            <span asp-validation-for="Concert.ConcertImageUrl" class="text-danger"></span>
                        </div>

                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Concert.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Create</button>
                                }
                            </div>

                            <div class="col-6 col-md-3">
                                <a asp-controller="Concert" asp-action="Index" class="btn btn-secondary border form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class=" col-2">
                    <img src="@Model.Concert.ConcertImageUrl" width="100%" style="border:5px; border:1px solid #B2BEB5" />
                </div>
            </div>
        </form>
        </div>
</div>

@section Scripts {
        <script>
            tinymce.init({
              selector: 'textarea',
              plugins:'anchor autolink charmap codesample emoticons link lists media searchreplace table visualblocks wordcount',
              toolbar: 'undo redo | tinymceai-chat tinymceai-quickactions tinymceai-review | blocks fontfamily fontsize | bold italic underline strikethrough | link media table mergetags | addcomment showcomments | spellcheckdialog a11ycheck typography uploadcare | align lineheight | checklist numlist bullist indent outdent | emoticons charmap | removeformat',
            });
        </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
