@model VibeWave.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to VibeWave</h1>
</div>

<div class="container mt-4">

    <form method="get" asp-action="Index" class="row mb-4 g-2 align-items-end">

        <!-- SEARCH -->
        <div class="col-md-5">
            <label asp-for="SearchString" class="form-label">Search</label>
            <input asp-for="SearchString"
                   class="form-control"
                   placeholder="concert name or actor..." />
        </div>

        <!-- CATEGORY -->
        <div class="col-md-4">
            <label asp-for="CategoryId" class="form-label">Category</label>

            <select asp-for="CategoryId"
                    class="form-select"
                    asp-items="Model.CategoryList">
                <option value="">--All Categories--</option>
            </select>
        </div>

        <!-- BUTTONS -->
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">
                Search
            </button>

            @if (!string.IsNullOrEmpty(Model.SearchString) ||
                        (Model.CategoryId.HasValue && Model.CategoryId > 0))
            {
                <a asp-action="Index" class="btn btn-secondary w-100 mt-2">
                    Clear All
                </a>
            }
        </div>
    </form>

    <!-- RESULTS COUNT -->
    @if (!string.IsNullOrEmpty(Model.SearchString) ||
        (Model.CategoryId.HasValue && Model.CategoryId > 0))
    {
        <p class="text-muted">
            Found @(Model.Concerts?.Count() ?? 0) result(s)
        </p>
    }

    <!-- CONCERT LIST -->
    @if (Model.Concerts != null && Model.Concerts.Any())
    {
        <div class="row">
            @foreach (var concert in Model.Concerts)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <img src="@(!string.IsNullOrEmpty(concert.ConcertImageUrl)
                                                              ? concert.ConcertImageUrl
                                 : "/images/concert/Concert.png")"
                     class="card-img-top"
                     style="height: 180px; object-fit: cover;" />
                       <div class="card-body d-flex flex-column">

                            <h5 class="card-title">@concert.ConcertName</h5>

                            <h6 class="text-muted">@concert.ActorName</h6>

                            <p class="card-text">
                                <strong>Date:</strong> @concert.DisplayDate <br />
                                <strong>Time:</strong> @concert.DisplayTime
                            </p>

                            <!-- PUSH BUTTONS TO BOTTOM -->
                            <div class="mt-auto">

                                <button type="button"
                                        class="btn btn-primary w-100"
                                        onclick="openModal(
                            '@concert.ConcertName',
                            '@concert.ActorName',
                            '@concert.Category?.Name',
                            '@concert.ConcertLocation',
                            '@concert.DisplayDate',
                            '@concert.DisplayTime',
                            '@($"NZ$ {concert.TicketPrice:0.00}")'
                        )">
                                    Details
                                </button>

                                <a asp-controller="Booking"
                                   asp-action="Create"
                                   asp-route-id="@concert.Id"
                                   class="btn btn-success w-100 mt-2">
                                    Book
                                </a>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>No concerts available.</p>
    }
</div>

<!-- MODAL -->
<div id="concertModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <div id="modalContent"></div>
    </div>
</div>

<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 1;
        padding-top: 200px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
        background: radial-gradient(circle, rgba(191, 221, 242, 1) 0%, rgba(204, 210, 249, 1) 25%, rgba(215, 201, 255, 1) 45%, rgba(232, 213, 252, 1) 71%, rgba(252, 227, 248, 1) 100%);
        margin: auto;
        padding: 20px;
        width: 80%;
        max-width: 500px;
        border-radius: 5px;
        text-align: center;
    }
</style>

<script>
    var modal = document.getElementById("concertModal");
    var span = document.getElementsByClassName("close")[0];

    span.onclick = function () {
        modal.style.display = "none";
    }

    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    function openModal(name, actor, category, location, date, time, price) {
        document.getElementById("modalContent").innerHTML = `
            <h2>${name}</h2>
            <hr/>
            <p><strong>Actor:</strong> ${actor}</p>
            <p><strong>Category:</strong> ${category}</p>
            <p><strong>Location:</strong> ${location}</p>
            <p><strong>Date:</strong> ${date}</p>
            <p><strong>Time:</strong> ${time}</p>
            <p><strong>Price:</strong> ${price}</p>
            <button onclick="closeModal()" class="btn btn-secondary">Close</button>
        `;
        modal.style.display = "block";
    }

    function closeModal() {
        modal.style.display = "none";
    }
</script>