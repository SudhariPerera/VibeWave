@using VibeWave.Models
@model List<Booking>

<h2 class="mb-4">Booking List</h2>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Concert</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Customer</th>
                <th>Email</th>
            }

            <th>Qty</th>
            <th>Date</th>
            <th>Total Price</th>

            @if (User.IsInRole("Admin"))
            {
                <th>Payment Method</th>
            }

            <th>QR Code</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>
                    <strong>@booking.Concert?.ConcertName</strong>
                </td>

                @if (User.IsInRole("Admin"))
                {
                    <td>@booking.CustomerName</td>
                    <td>@booking.Email</td>
                }

                <td>@booking.NumberOfTickets</td>

                <td>
                    @booking.BookingDate.ToString("dd MMM yyyy")
                </td>

                <td>
                    <strong>$@booking.TotalPrice</strong>
                </td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @booking.PaymentMethod
                    </td>
                }

                <td>
                    @if (!string.IsNullOrEmpty(booking.QrCodeUrl))
                    {
                        <img src="@booking.QrCodeUrl"
                             style="width:80px;height:80px;"
                             class="rounded border shadow-sm" />
                    }
                </td>

                <td>
                    @if (booking.PaymentStatus == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (booking.PaymentStatus == "Refunded")
                    {
                        <span class="badge bg-danger">
                            Refunded
                        </span>
                    }
                    else if (booking.PaymentStatus == "PayAtVenue")
                    {
                        <span class="badge bg-info">
                            Pay At Venue
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pending
                        </span>
                    }
                </td>

                <td>
                    <div class="btn-group" role="group">

                        <a asp-controller="Booking"
                           asp-action="BookingDetails"
                           asp-route-id="@booking.Id"
                           class="btn btn-primary">
                            <i class="bi bi-eye-fill"></i>
                        </a>

                        @if (!User.IsInRole("Admin"))
                        {
                            <a asp-controller="Booking"
                               asp-action="Delete"
                               asp-route-id="@booking.Id"
                               class="btn btn-danger">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>